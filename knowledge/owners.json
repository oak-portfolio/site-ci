  "separateOwners": {
    "disclosure": {
      "path": "knowledge/review.json",
      "validator": "scripts/knowledge/corpus.mjs",
      "outputs": [
        "all public evidence"
      ]
    },
    "eligibilityPolicy": {
      "path": "knowledge/policy.json",
      "validator": "src/lib/knowledge/eligibility.ts",
      "outputs": [
        "all public evidence"
      ]
    },
    "character": {
      "path": "agent-policy/character.json",
      "validator": "tests/agent/fixtures.test.mjs (version, identity and reference review)",
      "outputs": [
        "model system instructions via workers/oak-agent/src/knowledge/snapshot.ts"
      ],
      "boundary": "Reviewed character guidance is serialized into the live model system instructions. It can shape model behavior but cannot grant tools, spending, principal identity or private-source access."
    },
    "hardPolicy": {
      "path": "agent-policy/hard-policy.json",
      "validator": "packages/oak-agent-contracts/src/output.ts; packages/oak-agent-contracts/src/policy.ts; tests/agent/fixtures.test.mjs",
      "outputs": [
        "model system instructions for capability and funding boundaries"
      ],
      "boundary": "Hard-policy guidance is serialized into the live model system instructions. Server routes separately own permitted tools and operations, principal checks, private context and funding."
    },
    "providerSecrets": {
      "path": null,
      "mechanism": "deployment Worker secret/runtime environment; server-side Env fields consume configured values, which never enter the content workflow"
    },
    "serviceStatus": {
      "path": null,
      "mechanism": "private owner-services page and authenticated Worker endpoint, plus the local scripts/oak-service-status.mjs operator client; runtime readout, never an authored static fact"
    }
  },
  "generatedOutputs": [
    "src/data/generated/knowledgeSnapshot.json",
    "knowledge/releases/",
    "knowledge/active.json"
  ]
}
