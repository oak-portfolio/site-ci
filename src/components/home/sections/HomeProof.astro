---
import OptimizedPicture from "@/components/OptimizedPicture.astro";
import { proofSections } from "@/data/homePage";
import { proofContextByTitle } from "@/data/homeRegistry";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section class="section-block proof-block" aria-labelledby={id} data-oak-section="home.proof">
  <div class="page-container">
    <div class="center-copy">
      <h2 id={id} class="section-title"><slot /></h2>
    </div>

    <div class="proof-stack">
      {
        proofSections.map((section) => (
          <article class:list={["proof-row", section.imageFirst && "proof-row--image-first"]} data-oak-context={proofContextByTitle[section.title]}>
            <div class="proof-copy">
              <h3>{section.title}</h3>
              <p>{section.description}</p>
            </div>
            <div class="proof-media">
              <OptimizedPicture
                src={section.image}
                fallbackSrcSet={"imageSrcSet" in section ? section.imageSrcSet : undefined}
                sizes="(max-width: 1024px) calc(100vw - 48px), 814px"
                alt={section.imageAlt}
                width="821"
                height="526"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
