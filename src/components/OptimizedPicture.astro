---
import { getOptimizedImage } from "@/data/generated/optimizedImages";
import type { HTMLAttributes } from "astro/types";

type Loading = "eager" | "lazy";
type Decoding = "async" | "sync" | "auto";
type FetchPriority = "high" | "low" | "auto";
type ImgAttributes = HTMLAttributes<"img">;

type Props = {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  sizes?: string;
  fallbackSrcSet?: string;
  pictureClass?: string;
  class?: string;
  loading?: Loading;
  decoding?: Decoding;
  fetchpriority?: FetchPriority;
  role?: ImgAttributes["role"];
  "aria-hidden"?: ImgAttributes["aria-hidden"];
  "data-hero-portrait"?: string | boolean;
};

const {
  src,
  alt,
  width,
  height,
  sizes,
  fallbackSrcSet,
  pictureClass,
  class: imageClass,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  ...rest
} = Astro.props;

const optimized = getOptimizedImage(src);
const resolvedSizes = sizes ?? optimized?.sizes;
const resolvedWidth = width ?? optimized?.width;
const resolvedHeight = height ?? optimized?.height;
const fallbackSrc = optimized?.fallbackFormat === "avif" ? optimized.imageSet.webp ?? src : src;
---

<picture class:list={["optimized-picture", pictureClass]}>
  {
    optimized?.sources.avif && (
      <source type="image/avif" srcset={optimized.sources.avif} sizes={resolvedSizes} />
    )
  }
  {
    optimized?.sources.webp && (
      <source type="image/webp" srcset={optimized.sources.webp} sizes={resolvedSizes} />
    )
  }
  <img
    src={fallbackSrc}
    alt={alt}
    width={resolvedWidth}
    height={resolvedHeight}
    srcset={fallbackSrcSet}
    sizes={fallbackSrcSet ? resolvedSizes : undefined}
    class={imageClass}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    {...rest}
  />
</picture>
