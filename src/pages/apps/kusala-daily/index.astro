---
import KusalaDailyAppLayout from "@/layouts/KusalaDailyAppLayout.astro";
---

<KusalaDailyAppLayout
  title="Kusala Daily"
  eyebrow="iPhone and iPad"
  description="A private, offline companion for 108-count prayer practice and reading the bundled 24 Paccayo text."
>
  <section class="kusala-section" aria-labelledby="kusala-overview-heading">
    <h2 id="kusala-overview-heading">A calm daily practice space</h2>
    <p>
      Kusala Daily keeps two independent 108-count prayer trackers together with
      a continuous 24-section Paccayo reader. Progress and reading preferences
      stay on the device.
    </p>
    <ul>
      <li>Two independent counters with undo, reset, completion feedback, and on-device persistence.</li>
      <li>Myanmar prayer identities with the supplied verses and explanations.</li>
      <li>A responsive, accessible reader with semantic section jumps and adjustable text size.</li>
      <li>No account, advertising, analytics, cloud sync, or network connection.</li>
    </ul>
  </section>

  <section class="kusala-section" aria-labelledby="kusala-availability-heading">
    <h2 id="kusala-availability-heading">Availability</h2>
    <p class="kusala-status">Kusala Daily is in release preparation and is not yet available for download.</p>
    <p>
      Kusala Daily will be free to download. Public availability will follow
      App Store review. This page does not represent an App Store listing or
      promise a release date.
    </p>
  </section>

  <section class="kusala-section" aria-labelledby="kusala-links-heading">
    <h2 id="kusala-links-heading">App information</h2>
    <p>
      Read the <a href="/apps/kusala-daily/privacy/">privacy policy</a> or visit
      <a href="/apps/kusala-daily/support/">support</a> for help with the app.
    </p>
  </section>
</KusalaDailyAppLayout>
