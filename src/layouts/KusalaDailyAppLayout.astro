---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { oakKusalaDailyOpenGraph } from "@/lib/oakSourceCovers";

type Props = {
  title: string;
  description: string;
  eyebrow: string;
};

const { title, description, eyebrow } = Astro.props;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://steveoak.com"
).toString();
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const appCanonical = "https://steveoak.com/apps/kusala-daily/";
const appEntityId = `${appCanonical}#app`;
const navItems = [
  { label: "Overview", href: "/apps/kusala-daily/" },
  { label: "Privacy", href: "/apps/kusala-daily/privacy/" },
  { label: "Support", href: "/apps/kusala-daily/support/" },
];
const isOverview = normalizedPath === "/apps/kusala-daily";
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://steveoak.com/",
  },
  {
    "@type": "ListItem",
    "position": 2,
    "name": "Kusala Daily",
    "item": appCanonical,
  },
  ...(!isOverview
    ? [
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": canonical,
        },
      ]
    : []),
];
const jsonLdGraph = [
  ...(isOverview
    ? [
        {
          "@type": "MobileApplication",
          "@id": appEntityId,
          "name": "Kusala Daily",
          "description":
            "A free, private, offline iPhone and iPad companion for two 108-count prayer practices and a bundled 24-section Paccayo reader.",
          "applicationCategory": "LifestyleApplication",
          "operatingSystem": "iOS 16.0 or later; iPadOS 16.0 or later",
          "isAccessibleForFree": true,
          "author": { "@id": "https://steveoak.com/#person" },
          "url": appCanonical,
          "image": "https://steveoak.com/assets/apps/kusala-daily/icon.png",
        },
      ]
    : []),
  {
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumbs`,
    "itemListElement": breadcrumbItems,
  },
];
---

<BaseLayout
  title={title === "Kusala Daily" ? "Kusala Daily | Steve Oak" : `${title} | Kusala Daily`}
  description={description}
  canonicalUrl={canonical}
  noindex={false}
  showContactBand={false}
  showOakMascot={false}
  ogImage={oakKusalaDailyOpenGraph}
  ogImageAlt="Kusala Daily app icon on an OLED-black and gold product card"
  ogImageWidth={1200}
  ogImageHeight={630}
  webPageMainEntityId={isOverview ? appEntityId : undefined}
  jsonLdGraph={jsonLdGraph}
>
  <article class="kusala-page">
    <header class="kusala-hero">
      <div class="kusala-hero__inner page-container">
        <img
          class="kusala-icon"
          src="/assets/apps/kusala-daily/icon.png"
          width="180"
          height="180"
          alt="Kusala Daily app icon with a gold Dharma wheel and pink lotus"
          decoding="async"
          fetchpriority="high"
        />
        <div class="kusala-hero__copy">
          <p class="kusala-eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p>{description}</p>
        </div>
      </div>
    </header>

    <nav class="kusala-local-nav page-container" aria-label="Kusala Daily pages">
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/+$/, "");
          const isCurrent = normalizedPath === itemPath;
          return (
            <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="kusala-content page-container">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .kusala-page {
    min-height: 100vh;
    overflow-x: clip;
    padding-top: 96px;
    color: var(--text);
    background:
      radial-gradient(circle at 50% 0%, rgba(232, 177, 57, 0.12), transparent 34rem),
      #050505;
  }

  .kusala-hero {
    padding-block: clamp(56px, 8vw, 104px) 40px;
  }

  .kusala-hero__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 720px);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    justify-content: center;
  }

  .kusala-icon {
    width: clamp(132px, 18vw, 180px);
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
  }

  .kusala-hero__copy {
    display: grid;
    min-width: 0;
    gap: 16px;
  }

  .kusala-eyebrow {
    margin: 0;
    color: #e8b139;
    font-size: 13px;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .kusala-hero h1 {
    margin: 0;
    font-family: "GT Walsheim Pro", Inter, sans-serif;
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 500;
    line-height: 1;
  }

  .kusala-hero__copy > p:last-child {
    max-width: 680px;
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 18px;
    line-height: 30px;
  }

  .kusala-local-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: min(760px, calc(100% - (var(--gutter-x) * 2)));
    padding-block: 20px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .kusala-local-nav a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding-inline: 18px;
    color: rgba(255, 255, 255, 0.76);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .kusala-local-nav a[aria-current="page"] {
    border-color: rgba(232, 177, 57, 0.36);
    color: #050505;
    background: #e8b139;
  }

  .kusala-local-nav a:hover,
  .kusala-local-nav a:focus-visible {
    border-color: rgba(232, 177, 57, 0.7);
    color: #fff;
    transform: translateY(-1px);
  }

  .kusala-local-nav a[aria-current="page"]:hover,
  .kusala-local-nav a[aria-current="page"]:focus-visible {
    border-color: #f3ca70;
    color: #050505;
    background: #f3ca70;
  }

  .kusala-content {
    display: grid;
    gap: 24px;
    width: min(760px, calc(100% - (var(--gutter-x) * 2)));
    padding-block: 8px 112px;
  }

  .kusala-content :global(.kusala-section) {
    display: grid;
    gap: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    padding: clamp(24px, 4vw, 40px);
    background: rgba(17, 17, 17, 0.86);
  }

  .kusala-content :global(.kusala-section h2) {
    margin: 0;
    font-family: "GT Walsheim Pro", Inter, sans-serif;
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 500;
    line-height: 1.15;
  }

  .kusala-content :global(.kusala-section h3) {
    margin: 8px 0 0;
    font-size: 18px;
    line-height: 26px;
  }

  .kusala-content :global(.kusala-section p),
  .kusala-content :global(.kusala-section li) {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .kusala-content :global(.kusala-section ul) {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 22px;
  }

  .kusala-content :global(.kusala-section a) {
    color: #fff;
    font-weight: 600;
  }

  .kusala-content :global(.kusala-status) {
    color: #e8b139;
    font-weight: 600;
  }

  @supports (corner-shape: squircle) {
    .kusala-icon,
    .kusala-content :global(.kusala-section) {
      corner-shape: squircle;
    }

    .kusala-icon {
      border-radius: 44px;
    }

    .kusala-content :global(.kusala-section) {
      border-radius: 48px;
    }
  }

  @media (max-width: 700px) {
    .kusala-page {
      padding-top: 80px;
    }

    .kusala-hero {
      padding-block: 42px 28px;
    }

    .kusala-hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .kusala-hero__copy {
      justify-items: center;
    }

    .kusala-local-nav {
      padding-block: 18px 26px;
    }

    .kusala-local-nav a {
      min-height: 44px;
      padding-inline: 10px;
    }

    .kusala-content {
      padding-block: 6px 88px;
    }
  }

  @media (max-width: 420px) {
    .kusala-local-nav {
      gap: 8px;
    }

    .kusala-local-nav a {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kusala-local-nav a {
      transition: none;
    }
  }
</style>
