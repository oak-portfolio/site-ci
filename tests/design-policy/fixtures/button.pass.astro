---
import { Button } from "@/components/ui/button";
const active: boolean = true;
---
<Button variant="ghost" size="icon" class:list={["mobile-menu-button", active && "contact-trigger"]}>Menu</Button>
<style>
  .fixture { color: var(--text); background: rgba(255, 255, 255, 0.12); }
  @media (max-width: 640px) { .fixture { width: min(100%, 30rem); } }
</style>
